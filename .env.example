# ---------------------------------------------------------------------------
# Required. No defaults.
#
# Anything that describes a particular deployment is required on purpose. This
# repository is public, so a default would be inherited silently by a fork, and
# a production deploy could come up on a value nobody chose. The service
# refuses to start if any of these is missing or malformed.
# ---------------------------------------------------------------------------

# Public origin this service answers on. A bare origin: no path, no trailing
# slash. Used for startup logging and operator diagnostics only -- the embed
# document emits same-origin relative URLs, so this does not affect embeds.
#
# LibreTexts production: https://studio.libretexts.org
# Every H5P activity embedded in a LibreTexts textbook points at that host, but
# that contract is enforced by DNS and the reverse proxy, not by this value.
BASE_URL=http://localhost:5100

# MongoDB holding H5P content parameters, metadata and library records.
# Separate from Conductor's database: this service owns H5P primitives only.
MONGODB_URL=mongodb://localhost:27017

# S3 (or S3-compatible) buckets for content files, library files and uploads.
# LibreTexts production: libretexts-h5p-content / -libraries / -temp
S3_CONTENT_BUCKET=libretexts-h5p-content
S3_LIBRARY_BUCKET=libretexts-h5p-libraries
S3_TEMPORARY_BUCKET=libretexts-h5p-temp
AWS_REGION=us-west-2

# S3 credentials. Read by @lumieducation/h5p-mongos3, which requires them
# explicitly and will not fall back to an instance role or the AWS SDK's
# default credential chain: the service exits at startup with "Access key for
# S3 storage missing" if they are unset. Supply them from your secret store,
# never from a committed file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Origins allowed to drive the embed's styling API via postMessage. Comma
# separated, each a bare origin. Studio accepted these messages from any
# origin, which let any page framing an activity rewrite its DOM.
# LibreTexts production: https://adapt.libretexts.org
ALLOWED_EMBED_PARENT_ORIGINS=https://adapt.libretexts.org

# Hosts permitted to frame the embed route. A space-separated CSP source list:
# 'self', 'none', * or scheme-host with an optional leading *. wildcard.
# Validated and rebuilt at startup before it reaches the response header.
# LibreTexts production: https://*.libretexts.org https://*.libretexts.net
EMBED_FRAME_ANCESTORS=https://*.libretexts.org https://*.libretexts.net

# Origins where the embed hides its export, embed and H5P links because the
# host application supplies its own controls. Comma separated bare origins.
# Compared against the referrer's origin, so a path does not matter.
# LibreTexts production: https://adapt.libretexts.org
# Add https://local.adapt:8891 locally if you develop against ADAPT.
EMBED_ADAPT_REFERRERS=https://adapt.libretexts.org

# Parent hosts treated as first-party; everyone else sees the attribution
# badge. Comma separated bare host names, matched exactly or by dot-suffix.
# LibreTexts production: libretexts.org
EMBED_TRUSTED_PARENT_HOSTS=libretexts.org

# ---------------------------------------------------------------------------
# Optional. Shown with their defaults.
# ---------------------------------------------------------------------------

PORT=5100
NODE_ENV=development
LOG_LEVEL=debug

# Mongo database and collection names. Internal to this service.
MONGODB_DB=h5p
MONGODB_CONTENT_COLLECTION=h5p_content
MONGODB_LIBRARY_COLLECTION=h5p_libraries
MONGODB_COUNTER_COLLECTION=h5p_counters

# On-disk H5P client libraries, populated by `npm run fetch:h5p-core`.
# Coupled to the Dockerfile's COPY layout; changing these is rarely correct.
H5P_CORE_PATH=h5p/core
H5P_EDITOR_PATH=h5p/editor

# Set only for S3-compatible storage such as MinIO in local development.
# AWS_S3_ENDPOINT=http://localhost:9000

# Attribution badge shown when an untrusted host frames the embed. With no
# href the badge is not rendered at all, so a non-LibreTexts deployment shows
# no LibreTexts branding.
# EMBED_BADGE_HREF=https://studio.libretexts.org/
# EMBED_BADGE_LOGO_URL=https://cdn.libretexts.net/Logos/libretexts_icon.png
# EMBED_BADGE_LABEL=Powered by LibreStudio

# Allows `npm run fetch:h5p-core` to pull a ref with no recorded SHA-256.
# H5P_ALLOW_UNVERIFIED_REF=1

# ---------------------------------------------------------------------------
# Migration only. Not needed to run the service, and read lazily so the server
# never demands them. See `npm run migrate:studio-content`.
# ---------------------------------------------------------------------------

# STUDIO_MYSQL_HOST=localhost
# STUDIO_MYSQL_PORT=3306
# STUDIO_MYSQL_USER=root
# STUDIO_MYSQL_PASSWORD=
# STUDIO_MYSQL_DATABASE=studio_main

# ---------------------------------------------------------------------------
# Local verification harness. Used by `npm run verify:content-storage`, which
# needs a MongoDB and a MinIO running locally.
# ---------------------------------------------------------------------------

# TEST_MONGO_URL=mongodb://127.0.0.1:37018
# TEST_S3_ENDPOINT=http://127.0.0.1:9100
# TEST_S3_ACCESS_KEY_ID=minioadmin
# TEST_S3_SECRET_ACCESS_KEY=minioadmin
