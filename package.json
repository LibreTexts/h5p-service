{
  "name": "@libretexts/h5p-service",
  "version": "0.4.0",
  "private": true,
  "description": "H5P hosting and playback service for LibreTexts. Serves interactive activities migrated from LibreTexts Studio.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/LibreTexts/h5p-service.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "fetch:h5p-core": "node scripts/fetch-h5p-core.mjs",
    "verify:embed-contract": "npm run build && node scripts/verify-embed-contract.mjs",
    "verify:capability-token": "npm run build && node scripts/verify-capability-token.mjs",
    "postinstall": "node scripts/fetch-h5p-core.mjs",
    "verify:content-storage": "npm run build && node scripts/verify-content-storage.mjs",
    "verify:authoring": "npm run build && node scripts/verify-authoring.mjs",
    "migrate:studio-content": "tsx --env-file=.env src/migrations/importStudioContent.ts",
    "verify:studio-import": "tsx --env-file=.env src/migrations/verifyStudioImport.ts",
    "verify:embed-sweep": "tsx --env-file=.env src/migrations/sweepEmbeds.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@lumieducation/h5p-express": "10.0.5",
    "@lumieducation/h5p-mongos3": "10.0.4",
    "@lumieducation/h5p-server": "10.0.4",
    "express": "4.22.1",
    "express-fileupload": "1.5.1",
    "jose": "6.2.12",
    "mongodb": "^6.14.2",
    "pino": "9.5.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/express": "4.17.21",
    "@types/express-fileupload": "1.5.1",
    "@types/node": "24.19.2",
    "mysql2": "^3.24.6",
    "playwright-core": "1.64.0",
    "semantic-release": "25.0.9",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
